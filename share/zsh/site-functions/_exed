#compdef exed

_exed_target() {
  if (( ${+opt_args[-c]} )); then
    _files
  elif [[ $PREFIX == */* ]]; then
    _files -g '*(*)'
  else
    _path_commands
  fi
}

_exed_template_words() {
  local language line
  local -a args

  if (( ${+opt_args[-l]} )); then
    language=${opt_args[-l]}
    args=(-l "$language" -L)
  else
    args=(-L)
  fi

  command exed "${args[@]}" 2>/dev/null | while IFS= read -r line; do
    [[ $line == "  "* ]] || continue
    print -r -- "${line#  }"
  done
}

_exed_templates() {
  local -a templates

  templates=(${(f)"$(_exed_template_words)"})
  (( ${#templates} )) || return 1
  _describe -t templates 'template' templates
}

_exed() {
  local context state line
  typeset -A opt_args

  _arguments -s -S \
    '(-c)-a[find all PATH matches and choose one]' \
    '(-a)-c[create executable instead of finding it in PATH]' \
    '-B[fail if file exists in create mode]' \
    '-C[overwrite existing files in create mode]' \
    '-e+[choose editor]:editor:_command_names' \
    '-h[print help and exit]' \
    '-i+[custom interpreter path]:interpreter:_files' \
    '-I[set IFS line in created bash or zsh files]' \
    '-l+[language for created files]:language:(bash sh zsh python ruby perl php node awk sed)' \
    '-L[list available templates]' \
    '-m+[chmod-style mode for created files]:mode:(700 755 775)' \
    '-n[use env from PATH with LANGUAGE for created files]' \
    '-N[unset configured env option]' \
    '-o+[add option after interpreter line]:interpreter option:' \
    '-O[prompt before overwriting in create mode]' \
    '-P[preview selected template]' \
    '-t+[use language-scoped template for created files]:template:->template' \
    '-T[unset configured template option]' \
    '-v[print editor and file location before opening]' \
    '-V[print version and exit]' \
    ':executable name:->target' && return

  case $state in
    target) _exed_target ;;
    template) _exed_templates ;;
  esac
}

_exed "$@"
